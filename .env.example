# Cinderblock environment variables.
#
# Copy to .env.local for development. Production values live in EC2 .env and
# Supabase Vault — never commit either. Forkers: scripts/postclone.sh generates
# pg_audit_writer + pg_impersonator passwords and writes them here for you.

# --- Public (browser-visible) ---

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cookie domain. Use ".cinderblock.philiprehberger.com" in prod so marketing +
# app subdomains share the session. Use "localhost" or omit in dev.
NEXT_PUBLIC_COOKIE_DOMAIN=

# --- Server-only (do not prefix with NEXT_PUBLIC_) ---

# Service-role JWT — bypasses RLS. Confined to /src/lib/supabase/server-only.ts.
SUPABASE_SERVICE_ROLE_KEY=

# HS256 secret used by PostgREST to validate JWTs. Used to mint impersonation
# tokens with 60min TTL, sub=<target>, app_metadata.impersonated_by=<admin>.
SUPABASE_JWT_SECRET=

# Postgres connection strings for the dedicated app roles.
# Both use the session-mode port (:5432), not the transaction pooler (:6543).
PG_AUDIT_WRITER_URL=
PG_IMPERSONATOR_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Edge Functions ---
# HMAC the Next.js server signs Edge Function requests with so the functions
# reject anything not from the trusted app even if CORS is misconfigured.
EDGE_INTERNAL_SECRET=
# Comma-separated origin allow-list for CORS.
EDGE_ALLOWED_ORIGINS=https://cinderblock.philiprehberger.com,https://app.cinderblock.philiprehberger.com

# Used by invite-create to HMAC-sign invitation tokens.
INVITE_SIGNING_KEY=

# --- Observability ---
SENTRY_AUTH_TOKEN=
SENTRY_DSN=

# Supabase Management API — used by /status page + quota-alert pg_cron job.
SUPABASE_MANAGEMENT_API_TOKEN=

# Google Analytics 4 measurement ID (optional; leave blank in forks)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
